#!/bin/sh
# One build pipeline for all areas: only one cargo command runs at a time (or RALPH_BUILD_PIPELINES of them). Put this folder first on PATH (the engine does
# it when the project config says buildLock: true) and set RALPH_BUILD_LOCK to the lock file (default /tmp/ralph-cargo.lock).
# Cargo subcommands that call cargo again (clippy, fmt) skip the lock via RALPH_CARGO_LOCKED, so they never deadlock.
HERE="$(cd "$(dirname "$0")" && pwd)"
REST="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$HERE" | paste -sd: -)"
REAL="$(PATH="$REST" command -v cargo)" || { echo "bin/cargo: no real cargo on PATH" >&2; exit 127; }
if [ -n "$RALPH_CARGO_LOCKED" ]; then exec "$REAL" "$@"; fi
export RALPH_CARGO_LOCKED=1
LOCK="${RALPH_BUILD_LOCK:-/tmp/ralph-cargo.lock}"
PIPELINES="${RALPH_BUILD_PIPELINES:-1}"
if [ "$PIPELINES" -le 1 ]; then exec flock "$LOCK" "$REAL" "$@"; fi
# Several pipelines: take the first free slot lock (lock file per slot); if all are busy, wait and look again. The lock
# lives on file descriptor 9, which the exec'd cargo keeps open, so it is released when cargo exits.
while :; do
  slot=1
  while [ "$slot" -le "$PIPELINES" ]; do
    exec 9>"$LOCK.$slot"
    if flock -n 9; then exec "$REAL" "$@"; fi
    slot=$((slot + 1))
  done
  sleep 2
done
